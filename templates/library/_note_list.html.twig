{% for note in notes %}
<div class="note-entry collapsed">
    <div class="title-row">
        <a href="{{ path('note_preview', {'id': note.id}) }}">
            <h2 class="title">{{ note.title|e }} {{ ux_icon('lucide:link') }}</h2>
        </a>
        <button class="expander">
            <span class="prompt-open">{{ ux_icon('lucide:chevron-down') }}</span>
            <span class="prompt-close">{{ ux_icon('lucide:chevron-up') }}</span>
        </button>
    </div>
    <div class="topics">
        {% for topic in note.topics|split(',') %}
        {% if topic|trim != '' %}
        <div class="topic">
            <span>{{ topic|trim|e }}</span>
        </div>
        {% endif %}
        {% endfor %}
    </div>
    {% if note.description|trim != '' %}
    <p class="description">{{ note.description|e }}</p>
    {% endif %}
    <hr>
    <div class="details">
        <div class="short-detail username">
            {% if note.username|length == 0 %}
            {{ ux_icon('lucide:user') }} <i>(none)</i>
            {% elseif note.authorCount == 1 %}
            {{ ux_icon('lucide:user') }} {{ note.username|e }}
            {% else %}
            {{ ux_icon('lucide:user') }} {{ note.username|e }} +{{ note.authorCount - 1 }}
            {% endif %}
        </div>
        <div class="long-detail username">
            {% if note.username|length == 0 %}
            {{ ux_icon('lucide:user') }} <i>(none)</i>
            {% elseif note.authorCount == 1 %}
            {{ ux_icon('lucide:user') }} {{ note.username|e }}
            {% elseif note.authorCount == 2 %}
            {{ ux_icon('lucide:user') }} {{ note.username|e }} and {{ note.authorCount - 1 }} more author
            {% else %}
            {{ ux_icon('lucide:user') }} {{ note.username|e }} and {{ note.authorCount - 1 }} more authors
            {% endif %}
        </div>

        <div class="short-detail subjects">
            {{ ux_icon('lucide:book-open') }} {{ note.shortSubjects }}
        </div>
        <div class="long-detail subjects">
            {{ ux_icon('lucide:book-open') }} {{ note.subjects }}
        </div>

        <div class="short-detail rating">
            {% if note.rating is null %}
            {{ ux_icon('lucide:star') }} <i>(none)</i>
            {% else %}
            {{ ux_icon('lucide:star') }} {{ note.rating|round(2) }}
            {% endif %}
        </div>
        <div class="long-detail rating">
            {% if note.rating is null %}
            {{ ux_icon('lucide:star') }} <i>(none)</i>
            {% elseif note.ratingCount == 1 %}
            {{ ux_icon('lucide:star') }} {{ note.rating|round(2) }}/5 (1 rating)
            {% else %}
            {{ ux_icon('lucide:star') }} {{ note.rating|round(2) }}/5 ({{ note.ratingCount }} ratings)
            {% endif %}
        </div>

        {# <div class="short-detail comments">
            {{ ux_icon('lucide:message-square-text') }} {{ note.commentCount }}
        </div> #}
        <div class="long-detail comments">
            {% if note.commentCount == 1 %}
            {{ ux_icon('lucide:message-square-text') }} 1 comment
            {% else %}
            {{ ux_icon('lucide:message-square-text') }} {{ note.commentCount }} comments
            {% endif %}
        </div>

        <div class="short-detail time-added">
            {{ ux_icon('lucide:calendar-clock') }} {{ note.timeCreated|format_date('short', locale: 'en-SG') }}
        </div>
        <div class="long-detail time-added">
            {{ ux_icon('lucide:calendar-clock') }} {{ note.timeCreated|format_datetime('short', locale: 'en-SG') }}
        </div>

        {# <div class="short-detail info">
            {% if note.isFile %}
            {{ ux_icon('lucide:circle-question-mark') }} {{ note.fileType }}
            {% else %}
            {{ ux_icon('lucide:circle-question-mark') }} {{ note.hostName }}
            {% endif %}
        </div> #}
        <div class="long-detail info">
            {% if note.isFile %}
            {{ ux_icon('lucide:circle-question-mark') }} File ({{ note.fileType }})
            {% else %}
            {{ ux_icon('lucide:circle-question-mark') }} Website ({{ note.hostName }})
            {% endif %}
        </div>
        
    </div>
    <hr>
    <div class="actions">
        <div class="rating-buttons">
            Rate:
            <label><input type="radio" name="rating-{{ note.id }}">1</label>
            <label><input type="radio" name="rating-{{ note.id }}">2</label>
            <label><input type="radio" name="rating-{{ note.id }}">3</label>
            <label><input type="radio" name="rating-{{ note.id }}">4</label>
            <label><input type="radio" name="rating-{{ note.id }}">5</label>
            /5
        </div>
        <div class="action-buttons">
            <button class="add-to-reading-list">
                {{ ux_icon('lucide:heart') }}
                <span>Add to reading list</span>
            </button>
            <button class="comment">
                {{ ux_icon('lucide:message-square-text') }}
                <span>Comment</span>
            </button>
            <button class="collaborate">
                {{ ux_icon('lucide:users') }}
                <span>Request to collaborate</span>
            </button>
            <button class="report">
                {{ ux_icon('lucide:flag') }}
                <span>Report</span>
            </button>
        </div>
    </div>

</div>
{% endfor %}