<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}PeerView{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/favicon.png') }}">
        <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% block javascripts %}
        {% endblock %}
    </head>
    <body>
        <div id="topbar">
            <button id="navigation-menu-button">
                <img src="{{ asset('images/menu.svg') }}" alt="Menu" />
            </button>
            <button id="login">Login</button>
        </div>
        <nav id="navigation-menu">
            <table>
                <tr>
                    <td><a href="/">Home</a></td>
                    <th>Library</th>
                    <th>Account</th>
                    <th>Fun</th>
                </tr>
                <tr>
                    <td></td>
                    <td><a href="/library">Library</a></td>
                    <td><a>Profile</a></td>
                    <td><a href="/canvas">Canvas</a></td>
                </tr>
                <tr>
                    <td></td>
                    <td></td>
                    <td><a>Settings</a></td>
                    <td></td>
                </tr>
            </table>
        </nav>
        <div id="navigation-menu-shadow"></div>
        <main id="containing">
            {% block content %}{% endblock %}
        </main>
    </body>
</html>
