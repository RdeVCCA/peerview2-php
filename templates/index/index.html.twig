{% extends "base.html.twig" %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('styles/index.css') }}" />
{% endblock %}

{% block content %}
<div id="index">
    <section id="hero">
        <img id="logo" src="{{ asset('images/logo.svg') }}" alt="Logo" />
        <h1 id="slogan">RdeV's own platform for sharing study notes.</h1>
    </section>
    <section id="notes-section">
        {#
            round(-2) rounds to nearest 100,
            where the number represents how many digits after the decimal should be included
        #}
        <h1>Join {{ userCount|round(-2, 'floor') }}+ users making {{ noteCount|round(-2, 'floor') }}+ notes</h1>
        <div id="preview-select">
            <div id="top-notes-button" class="selected">Top</div>
            <div id="newest-notes-button">New</div>
        </div>
        <div id="notes-table">
            <div id="top-notes" class="notes">
                <div>Visits</div>
                <div>Title</div>
                <div>Description</div>
                {% for note in topNotes %}
                <div>{{ note.visits }}</div>
                <div>{{ note.title }}</div>
                <div>{{ note.description }}</div>
                {% endfor %}
            </div>
            <div id="newest-notes" class="notes hidden">
                <div>Upload time</div>
                <div>Title</div>
                <div>Description</div>
                {% for note in newestNotes %}
                <div>{{ note.timeCreated|format_datetime('short') }}</div>
                <div>{{ note.title }}</div>
                <div>{{ note.description }}</div>
                {% endfor %}
            </div>
        </div>
    </section>
    <section id="points">
        <div class="points-box">
            <h1>Customizable</h1>
            <p>Select topics to focus on, create reading lists, PeerView will remember them all.</p>
        </div>
        <div class="points-box">
            <h1>Powerful</h1>
            <p>Support for over 10 different file formats and 10 sites; navigate them all with the powerful sorting system.</p>
        </div>
        <div class="points-box">
            <h1>Fun</h1>
            <p>Gather points to spend on <a href="/canvas">our pixel canvas</a>, draw as you please.</p>
        </div>
        <div class="points-box">
            <h1>Easy</h1>
            <p>Simply login with your ICON email to get started.</p>
        </div>
    </section>
    <footer>
        <div id="footer-content">
            <p>Created by RV, for RV.</p>
            <a href="mailto:rdevcca@gmail.com">rdevcca@gmail.com</a>
            <a href="https://rdev.x10.mx/">rdev.x10.mx</a>
        </div>
    </footer>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script type="module">import "{{ asset('javascripts/index.js') }}";</script>
{% endblock %}